# ===========================================================================
# Tourism Analytics — Environment Configuration
# Скопируй этот файл: cp .env.example .env
# ===========================================================================

# --- Environment ---
ENVIRONMENT=development

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://tourism:tourism_pass@localhost:5432/tourism

# --- ChromaDB (векторная БД) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=tourism_docs

# --- LLM Provider ---
# Доступные: gemini, gigachat, groq, mistral, deepseek, openrouter
# mistral — основной (1B токенов/месяц, работает из РФ)
# gigachat — резервный (нативный русский, CORP credentials)
# groq — быстрый (требует VPN)
LLM_PROVIDER=mistral

# --- Google Gemini API (резервный, требует VPN) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3

# --- GigaChat LLM (корпоративный) ---
# Модели: GigaChat-2, GigaChat-2-Pro, GigaChat-Pro, GigaChat-Max
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TEMPERATURE=0.2
GIGACHAT_MAX_TOKENS=2048
GIGACHAT_TOP_P=0.9
GIGACHAT_REPETITION_PENALTY=1.1
# Credentials для LLM (CORP scope для корпоративных моделей)
GIGACHAT_LLM_CREDENTIALS=
GIGACHAT_LLM_SCOPE=GIGACHAT_API_CORP

# --- Groq API (быстрый, требует VPN) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Mistral API (основной, 1B токенов/месяц, работает из РФ) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_MODEL_FAST=ministral-8b-latest
MISTRAL_MODEL_BALANCED=mistral-small-latest
MISTRAL_TEMPERATURE=0.3
MISTRAL_MAX_TOKENS=1000

# --- DeepSeek API (работает из РФ) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (резервный, 100+ моделей) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# --- GigaChat Embeddings (отдельные credentials, PERS scope) ---
# Используются для ChromaDB / RAG
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- RAG ---
RAG_SEARCH_RESULTS=5
RAG_INDEX_BATCH_SIZE=10

# --- Parsers ---
PARSER_IRK_URL=https://irk.ru/afisha/
PARSER_CULTURE38_URL=https://culture38.ru/
PARSER_TIMEOUT=60
PARSER_BATCH_SIZE=10
PARSER_SSL_VERIFY=true

# --- Redis (кэширование) ---
# Запуск: docker-compose up -d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=300

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost","http://localhost:80"]

# --- Security ---
# API key для защищённых endpoints (parser, admin)
# Если не указан - endpoints открыты (только для dev!)
API_KEY=
# Telegram API (для парсера Telegram-каналов)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Rate limiting: запросов в период
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# --- Yandex Maps JS API (для страницы /map) ---
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-js-api-key
