# Vite читает только переменные с префиксом VITE_*
# Скопируй в .env и подставь свой ключ.
# Yandex Maps JS API key защищается через domain restrictions в личном кабинете
# Yandex Cloud (https://developer.tech.yandex.ru/), поэтому может находиться
# в клиентском бандле (это публичный конфиг, не серверный секрет).

VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-js-api-key

# Backend URL — оставить пустым в production за nginx, или прописать для dev.
# VITE_API_BASE=http://localhost:8000
