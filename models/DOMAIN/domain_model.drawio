<mxfile host="app.diagrams.net">
  <diagram id="domain-model" name="Диаграмма предметной области">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#f5f0e6">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Рамка -->
        <mxCell id="frame" value="class Domain Objects" style="shape=umlFrame;whiteSpace=wrap;html=1;width=140;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1100" height="700" as="geometry"/>
        </mxCell>
        
        <!-- Примечание -->
        <mxCell id="note" value="Диаграмма предметной области&#xa;описывает основные объекты&#xa;системы туризма Прибайкалья." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=0;spacingLeft=5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="180" height="70" as="geometry"/>
        </mxCell>
        
        <!-- Запрос - центральный верхний -->
        <mxCell id="query" value="Запрос" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="query_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="query">
          <mxGeometry y="26" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Ответ -->
        <mxCell id="response" value="Ответ" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="response_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="response">
          <mxGeometry y="26" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Прогноз -->
        <mxCell id="forecast" value="Прогноз" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="forecast_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="forecast">
          <mxGeometry y="26" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Средство размещения - центральный -->
        <mxCell id="accommodation" value="Средство размещения" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="accommodation_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="accommodation">
          <mxGeometry y="26" width="160" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Событие -->
        <mxCell id="event" value="Событие" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="event_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="event">
          <mxGeometry y="26" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Район -->
        <mxCell id="district" value="Район" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="district_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="district">
          <mxGeometry y="26" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Источник данных -->
        <mxCell id="datasource" value="Источник данных" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="datasource_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="datasource">
          <mxGeometry y="26" width="140" height="34" as="geometry"/>
