        <!-- Номерной фонд -->
        <mxCell id="room" value="Номерной фонд" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="room_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="room">
          <mxGeometry y="26" width="140" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Статистика -->
        <mxCell id="stats" value="Статистика&#xa;загруженности" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="580" y="450" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="stats_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="stats">
          <mxGeometry y="36" width="120" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Концерт (специализация События) -->
        <mxCell id="concert" value="Концерт" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="concert_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="concert">
          <mxGeometry y="26" width="100" height="34" as="geometry"/>
        </mxCell>
        
        <!-- Фестиваль (специализация События) -->
        <mxCell id="festival" value="Фестиваль" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="festival_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="festival">
          <mxGeometry y="26" width="100" height="34" as="geometry"/>
        </mxCell>
        
        <!-- История запросов -->
        <mxCell id="history" value="История запросов" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="history_attr" value="" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="history">
          <mxGeometry y="26" width="140" height="34" as="geometry"/>
        </mxCell>
        
        <!-- СВЯЗИ -->
        
        <!-- История агрегирует Запрос -->
        <mxCell id="r1" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=1;startSize=12;" edge="1" parent="1" source="history" target="query">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Запрос -> Ответ -->
        <mxCell id="r2" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="query" target="response">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Ответ агрегирует Прогноз -->
        <mxCell id="r3" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=0;startSize=12;" edge="1" parent="1" source="response" target="forecast">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Район -> Средство размещения -->
        <mxCell id="r4" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="district" target="accommodation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Средство размещения -> Событие -->
        <mxCell id="r5" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="accommodation" target="event">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Событие -> Источник данных -->
        <mxCell id="r6" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="event" target="datasource">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Средство размещения агрегирует Номерной фонд -->
        <mxCell id="r7" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=1;startSize=12;" edge="1" parent="1" source="accommodation" target="room">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Средство размещения агрегирует Статистика -->
        <mxCell id="r8" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=0;startSize=12;" edge="1" parent="1" source="accommodation" target="stats">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Событие обобщает Концерт -->
        <mxCell id="r9" style="endArrow=block;endFill=0;endSize=12;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="concert" target="event">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Событие обобщает Фестиваль -->
        <mxCell id="r10" style="endArrow=block;endFill=0;endSize=12;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="festival" target="event">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Прогноз -> Средство размещения -->
        <mxCell id="r11" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=0;startSize=12;" edge="1" parent="1" source="forecast" target="accommodation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Прогноз -> Событие -->
        <mxCell id="r12" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=diamondThin;startFill=0;startSize=12;" edge="1" parent="1" source="forecast" target="event">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="220"/>
              <mxPoint x="780" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
