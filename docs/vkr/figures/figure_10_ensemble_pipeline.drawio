        <mxCell id="fe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Verdana;fontSize=10;fontStyle=0;verticalAlign=middle;" value="Инженерия признаков&#xa;(FeatureEngineering)&#xa;&#xa;38 признаков × 8 групп:&#xa;календарные (8), праздничные (5),&#xa;лаговые (7), скользящие (5),&#xa;погодные (4), событийные (3),&#xa;трендовые (2), ценовые (4)" vertex="1">
