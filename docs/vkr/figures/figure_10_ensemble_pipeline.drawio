        </mxCell>
        <mxCell id="xgboost" parent="models_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Verdana;fontSize=10;" value="XGBoost / LightGBM&#xa;&#xa;Градиентный бустинг&#xa;Квантильная регрессия&#xa;(интервалы 10%–90%)" vertex="1">
