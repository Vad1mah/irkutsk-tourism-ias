          <mxGeometry height="300" width="150" x="570" y="175" as="geometry" />
        </mxCell>
        <mxCell id="prophet" parent="models_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Verdana;fontSize=10;" value="Prophet&#xa;&#xa;Годовая / недельная&#xa;сезонность (Фурье)&#xa;Погода и праздники&#xa;как внешние регрессоры" vertex="1">
